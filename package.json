{
  "name": "hungriorder",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev -w hungriorder-customer",
    "dev:admin": "npm run dev -w hungriorder-admin",
    "build": "npm run build -w hungriorder-customer && npm run build -w hungriorder-admin",
