# Point the standalone admin at the SAME Supabase project as the main
# goana-ar-app (Dashboard -> Project Settings -> API). Copy to .env and fill in.
VITE_SUPABASE_URL=https://your-goana-ar-app-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-goana-ar-app-anon-key

# Optional overrides
# VITE_STOREFRONT_URL=https://hungriorder.com
# VITE_HUNGRIAR_ADMIN_URL=https://hungriar.app/admin
