# Point the storefront at the SAME Supabase project as the main goana-ar-app
# (Dashboard -> Project Settings -> API). Copy to .env and fill in.
VITE_SUPABASE_URL=https://your-goana-ar-app-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-goana-ar-app-anon-key

# Recommended: Ola Maps API key — India-focused geocoding, free 5M
# calls/month, signup needs NO billing card. Console:
# https://maps.olakrutrim.com (create project -> API key)
# VITE_OLA_MAPS_API_KEY=your-ola-maps-api-key

# Optional alternative: Google Maps Platform key with "Geocoding API"
# enabled (requires a billing account). Used when the Ola key is absent
# or an Ola call fails. Without any key the app falls back to
# OpenStreetMap automatically.
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
